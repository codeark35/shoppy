# ── API ───────────────────────────────────────────────────────────────────────
# URL base del backend (sin trailing slash). En desarrollo, usar /api (proxiado por Vite).
VITE_API_URL=/api
VITE_API_VERSION=v1

# ── App ────────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Mi Tienda
VITE_APP_VERSION=1.0.0

# ── Firebase ── Obtener desde: Firebase Console → Configuración del proyecto ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── Monitoreo (Sentry) ─────────────────────────────────────────────────────────
# Opcional. Obtener desde sentry.io → Settings → Projects → DSN
VITE_SENTRY_DSN=
