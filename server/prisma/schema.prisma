// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  WAREHOUSE
}

enum OrderStatus {
  PENDING
  PAYMENT_PROCESSING
  PAID
  PREPARING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PromotionScope {
  PRODUCT
  CATEGORY
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  passwordHash     String?
  name             String
  phone            String?
  role             Role               @default(CUSTOMER)
  addresses        Address[]
  orders           Order[]
  wishlist         Wishlist[]
  reviews          Review[]
  pushSubscriptions PushSubscription[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  label      String   // ej: "Casa", "Oficina"
  street     String
  city       String
  department String
  zipCode    String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ─── CATALOG ──────────────────────────────────────────────────────────────────

model Category {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  imageUrl         String?
  coverImageUrl    String?
  parentId         String?
  isFeatured       Boolean    @default(false)
  featuredPosition Int        @default(0)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  promotions PromotionCategory[]
  createdAt DateTime   @default(now())
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  basePrice   Decimal          @db.Decimal(10, 2)
  images      ProductImage[]
  variants    ProductVariant[]
  category    Category         @relation(fields: [categoryId], references: [id])
  categoryId  String
  isActive    Boolean          @default(true)
  isFeatured  Boolean          @default(false)
  wishlist    Wishlist[]
  reviews     Review[]
  promotions  PromotionProduct[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductVariant {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  sku        String   @unique
  attributes Json     // { "color": "Rojo", "talle": "M" }
  price      Decimal  @db.Decimal(10, 2)
  stock      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── ORDERS ───────────────────────────────────────────────────────────────────

model Order {
  id             String         @id @default(cuid())
  orderNumber    Int            @unique @default(autoincrement())
  user           User           @relation(fields: [userId], references: [id])
  userId         String
  status         OrderStatus    @default(PENDING)
  items          OrderItem[]
  payment        Payment?
  shipping       OrderShipping?
  coupon         Coupon?        @relation(fields: [couponId], references: [id])
  couponId       String?
  discountAmount Decimal?       @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model OrderItem {
  id                  String   @id @default(cuid())
  order               Order    @relation(fields: [orderId], references: [id])
  orderId             String
  variantId           String
  sku                 String
  name                String   // snapshot del nombre al momento de compra
  imageUrl            String?
  price               Decimal  @db.Decimal(10, 2) // snapshot del precio unitario original
  quantity            Int
  unitDiscountApplied Decimal? @db.Decimal(10, 2) // descuento por unidad aplicado (promo/cupón)
  unitPriceFinal      Decimal? @db.Decimal(10, 2) // precio final por unidad tras descuento
}

model OrderShipping {
  id             String        @id @default(cuid())
  order          Order         @relation(fields: [orderId], references: [id])
  orderId        String        @unique
  recipientName  String
  phone          String
  addressLabel   String        @default("")
  street         String
  city           String
  department     String
  country        String        @default("PY")
  zipCode        String?
  trackingNumber String?
  shippingCost   Decimal       @db.Decimal(10, 2) @default(0)
  shippingRate   ShippingRate? @relation(fields: [shippingRateId], references: [id])
  shippingRateId String?
  createdAt      DateTime      @default(now())
}

// ─── PAYMENTS ─────────────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  order         Order         @relation(fields: [orderId], references: [id])
  orderId       String        @unique
  provider      String        @default("bancard")
  shopProcessId String        @unique
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  confirmedAt   DateTime?
  rawWebhook    Json?         // payload bruto del webhook para auditoría
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ─── FASE 2: SHIPPING ──────────────────────────────────────────────────────────

model ShippingZone {
  id          String         @id @default(cuid())
  name        String
  departments String[]       // ["Central", "Alto Paraná"]
  rates       ShippingRate[]
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
}

model ShippingRate {
  id             String          @id @default(cuid())
  zone           ShippingZone    @relation(fields: [zoneId], references: [id])
  zoneId         String
  name           String          // "Envío estándar", "Envío express"
  price          Decimal         @db.Decimal(10, 2)
  estimatedDays  Int             // días hábiles estimados
  isActive       Boolean         @default(true)
  orderShippings OrderShipping[]
  createdAt      DateTime        @default(now())
}

// ─── FASE 2: PROMOTIONS ────────────────────────────────────────────────────────

model Coupon {
  id                String       @id @default(cuid())
  code              String       @unique
  description       String?
  discountType      DiscountType
  discountValue     Decimal      @db.Decimal(10, 2)
  minPurchaseAmount Decimal?     @db.Decimal(10, 2)
  maxUses           Int?
  usedCount         Int          @default(0)
  validFrom         DateTime     @default(now())
  validUntil        DateTime?
  isActive          Boolean      @default(true)
  orders            Order[]
  createdAt         DateTime     @default(now())
}

model Promotion {
  id                String              @id @default(cuid())
  name              String
  description       String?
  scope             PromotionScope
  discountType      DiscountType
  discountValue     Decimal             @db.Decimal(10, 2)
  minPurchaseAmount Decimal?            @db.Decimal(10, 2)
  priority          Int                 @default(0)
  combinable        Boolean             @default(false)
  validFrom         DateTime            @default(now())
  validUntil        DateTime?
  isActive          Boolean             @default(true)
  products          PromotionProduct[]
  categories        PromotionCategory[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model PromotionProduct {
  id          String    @id @default(cuid())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String

  @@unique([promotionId, productId])
}

model PromotionCategory {
  id          String    @id @default(cuid())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String

  @@unique([promotionId, categoryId])
}

// ─── FASE 2: REVIEWS ───────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  rating     Int      // 1–5
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, productId])
}

// ─── FASE 2: WISHLIST ──────────────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─── FASE 2: PUSH NOTIFICATIONS ───────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ─── BANNERS ──────────────────────────────────────────────────────────────────

enum BannerType {
  HERO
  PROMO
  PROMO_FOOTER
  PROMO_STRIP
}

model Banner {
  id         String     @id @default(cuid())
  title      String
  subtitle   String?
  imageUrl   String
  buttonText String?
  buttonLink String?
  type       BannerType @default(HERO)
  isActive   Boolean    @default(true)
  position   Int        @default(0)
  validFrom  DateTime?
  validUntil DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// ─── ANALYTICS ───────────────────────────────────────────────────────────────

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  CATEGORY_VIEW
  SEARCH
  ADD_TO_CART
  REMOVE_FROM_CART
  CHECKOUT_START
  PURCHASE
  BANNER_CLICK
}

model AnalyticsEvent {
  id          String             @id @default(cuid())
  type        AnalyticsEventType
  sessionId   String?
  userId      String?
  productId   String?
  categoryId  String?
  bannerId    String?
  searchQuery String?
  page        String?
  referrer    String?
  value       Float?
  metadata    Json?
  createdAt   DateTime           @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([sessionId])
  @@index([userId])
  @@index([productId])
  @@index([categoryId])
  @@index([type, createdAt])
}
